APP_URL=https://pasalo.example.com

# Contraseña que usará quien suba los archivos.
UPLOAD_PASSWORD=cambia-esto
AUTH_SECRET=secreto-largo-distinto-1
SHARE_SECRET=secreto-largo-distinto-2

# MinIO se expone mediante el segundo hostname del túnel.
S3_ENDPOINT=https://files.example.com
S3_REGION=us-east-1
S3_BUCKET=pasalo
S3_ACCESS_KEY_ID=el-mismo-usuario-de-minio
S3_SECRET_ACCESS_KEY=la-clave-de-minio
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE_BYTES=21474836480

# Activar cuando tengamos el SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Pásalo <share@example.com>"
NOTIFICATION_EMAIL=
