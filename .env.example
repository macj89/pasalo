# URL pública donde estará desplegada la app, sin barra final.
APP_URL=https://archivos.tudominio.com

# Acceso privado para quien sube archivos.
UPLOAD_PASSWORD=cambia-esta-clave
AUTH_SECRET=genera-un-secreto-largo-y-aleatorio
SHARE_SECRET=genera-otro-secreto-largo-y-aleatorio

# Cloudflare R2, Backblaze B2 o cualquier almacenamiento S3 compatible.
S3_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=pasalo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Opcionales.
MAX_FILE_SIZE_BYTES=21474836480

# Email saliente. Funciona con el SMTP de vuestro proveedor de correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Pásalo <share@example.com>

# Aquí llegarán los avisos de primera descarga.
NOTIFICATION_EMAIL=
